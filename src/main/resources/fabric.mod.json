{
  "schemaVersion": 1,
  "id": "legacy-lwjgl3",
  "version": "${version}",
  "name": "Legacy LWJGL3",
  "description": "A Grotesque hack to bring LWJGL 3 back to legacy versions of Minecraft.",
  "authors": [
    "All the LWJGL 2 and 3 people!",
    "gudenau for creating the original forge mod",
    "Zarzelcow (me) porting it to fabric",
    "moehreag (updating, fixing)",
    "FMG793 (port to cypress fabric)"
  ],
  "contact": {
    "sources": "https://github.com/Cfauto28/CypressLWJGL3"
  },
  "license": "LGPL-2.1-only",
  "icon": "assets/legacy-lwjgl3/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
	    "io.github.moehreag.legacylwjgl3.LegacyLWJGL3"
    ]
  },
  "mixins": [
    "legacy-lwjgl3.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.12.0",
    "minecraft": "<1.13",
    "cypress_lib_core": "*",
    "osl": "*"
  },
  "conflicts": {
    "de_awt": "*"
  }
}
